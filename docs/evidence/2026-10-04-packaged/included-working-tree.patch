+# Safe delivery metadata only: never include transcript text or exception messages.
+_delivery_events = deque(maxlen=300)
+_delivery_events_lock = threading.Lock()
+
+
+def _delivery_event(candidate_id, ref, source, stream, stage, outcome, reason, **context):
+    event = {
+        "candidate_id": candidate_id, "reference": ref,
+        "source": source, "stream": stream or "unknown",
+        "language": (SECONDARY_LANGUAGE if stream == "secondary" else
+                     PRIMARY_LANGUAGE if stream == "primary" else "unknown"),
+        "timestamp": _dt.datetime.now(_dt.timezone.utc).isoformat(),
+        "stage": stage, "outcome": outcome, "reason": reason, **context,
+    }
+    with _delivery_events_lock:
+        _delivery_events.append(event)
+    logger.info("VERSE_DELIVERY %s", json.dumps(event, ensure_ascii=False),
+                extra={"vv_delivery_event": True})
+
+
+def get_delivery_events() -> list:
+    """Bounded, read-only snapshot for the GUI and support diagnostics."""
+    with _delivery_events_lock:
+        return [dict(event) for event in _delivery_events]
+
+
+def _delivery_candidate(ref, source, stream, candidate_id=None):
+    if candidate_id is None:
+        candidate_id = uuid.uuid4().hex[:12]
+        _delivery_event(candidate_id, ref, source, stream, "candidate", "DETECTED",
+                        "Reference candidate produced for delivery")
+    return candidate_id
+
+
+def _normalize_delivery_reference(ref):
+    match = re.fullmatch(r"(.+?)\s+(\d+)(?::(\d+))?", str(ref or "").strip())
+    if not match:
+        return None
+    book = resolve_book_eng(match[1])
+    if not book or int(match[2]) < 1 or (match[3] and int(match[3]) < 1):
+        return None
+    return f"{book} {int(match[2])}" + (f":{int(match[3])}" if match[3] else "")
+
 
